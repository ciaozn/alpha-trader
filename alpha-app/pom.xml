<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ciaozn.alphatrader</groupId>
        <artifactId>alpha-trader-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>alpha-app</artifactId>
    <name>alpha-app</name>
    <description>Spring Boot assembly: profiles, wiring, monitoring, alerts.</description>

    <properties>
        <!-- Not managed by the Spring Boot BOM. Local-dev historical data store (DESIGN §10). -->
        <sqlite-jdbc.version>3.46.1.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- P4: REST status endpoint (T402). Only the online profiles run a web container;
             backtest and download set spring.main.web-application-type=none. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- P4: QQ Mail alerting (T401). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- P4: MySQL 8 on the server (T408); SQLite stays the local default. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <!-- Declared rather than inherited transitively through alpha-gateway: DownloadWiring
             builds an OkHttpClient in main code, and a module that compiles against a dependency
             it does not declare breaks the day the other module swaps its HTTP client.
             Version comes from the Spring Boot BOM. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-strategy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-risk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-execution</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-backtest</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
