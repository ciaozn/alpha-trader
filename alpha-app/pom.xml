<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ciaozn.alphatrader</groupId>
        <artifactId>alpha-trader-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>alpha-app</artifactId>
    <name>alpha-app</name>
    <description>Spring Boot assembly: profiles, wiring, monitoring, alerts.</description>

    <properties>
        <!-- Not managed by the Spring Boot BOM. Local-dev historical data store (DESIGN §10). -->
        <sqlite-jdbc.version>3.46.1.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-strategy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-risk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-execution</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ciaozn.alphatrader</groupId>
            <artifactId>alpha-backtest</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
