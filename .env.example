# Alpha Trader environment template. Copy to .env and fill in. NEVER commit .env.

# --- Binance (required when trading.enabled=true in paper/live profiles) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- OKX (T406; demo trading for testnet=true) ---
OKX_API_KEY=
OKX_API_SECRET=
# The passphrase chosen when the key was created - OKX requires it on every signed request.
OKX_PASSPHRASE=

# --- Business store (T408): SQLite locally, MySQL on the VPS ---
# Leave unset for the local default (jdbc:sqlite:data/trading.db).
# Local durable MySQL (brew services): jdbc:mysql://127.0.0.1:3306/alpha_trader, user alpha.
ALPHA_STORE_JDBC_URL=
ALPHA_DB_USER=
ALPHA_DB_PASSWORD=
# docker-compose only: the MySQL container's root password (used by its healthcheck).
ALPHA_DB_ROOT_PASSWORD=

# --- Runtime switches (docker-compose reads these; all have safe defaults) ---
# paper | live. live is the only profile that trades real money.
ALPHA_PROFILE=paper
# binance | okx (T406)
ALPHA_GATEWAY=binance
# true = testnet. Flipping this to false for the wrong profile is caught by the startup preflight.
ALPHA_BINANCE_TESTNET=true
# Must be true for orders to be sent at all.
ALPHA_TRADING_ENABLED=false

# --- Alert email via QQ Mail SMTP (P4) ---
# Use the SMTP authorization code from QQ Mail settings, NOT your QQ password.
ALERT_SMTP_USERNAME=ciaozn@qq.com
ALERT_SMTP_AUTH_CODE=
ALERT_EMAIL_TO=ciaozn@qq.com
